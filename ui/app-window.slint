import { Button, ScrollView, CheckBox, Palette } from "std-widgets.slint";

import "./fonts/SymbolsNerdFont-Regular.ttf";
import "./fonts/HackNerdFont-Regular.ttf";
import "./fonts/UbuntuNerdFont-Regular.ttf";
import "./fonts/UbuntuMonoNerdFont-Regular.ttf";
import "./fonts/UbuntuSansNerdFont-Regular.ttf";

export global Theme {
    in-out property <bool> is_dark: false;

    // Window & Panels (KDE Breeze: Light #eff0f1, Dark #31363b)
    out property <color> window_bg: is_dark ? #31363b : #eff0f1;
    out property <color> panel_bg: is_dark ? #31363b : #eff0f1;
    // Views (KDE Breeze: View Normal Light #ffffff, Dark #232629)
    out property <color> view_bg: is_dark ? #232629 : #ffffff;
    out property <color> sidebar_bg: is_dark ? #2a2e32 : #ffffff;

    // Borders & Dividers (KDE Breeze: Dark #3d444b, Light #cbd5e1 / #e2e8f0)
    out property <color> border: is_dark ? #3d444b : #cbd5e1;
    out property <color> divider: is_dark ? #3d444b : #e2e8f0;

    // Typography (KDE Breeze: Shade Black #232629 vs Paper White #fcfcfc)
    out property <color> text_primary: is_dark ? #fcfcfc : #232629;
    out property <color> text_secondary: is_dark ? #a1a9b1 : #64748b;
    out property <color> text_muted: is_dark ? #7f8c8d : #94a3b8;

    // Accent (KDE Plasma Blue #3daee9)
    out property <color> accent: #3daee9;
    out property <color> accent_hover: is_dark ? #2980b9 : #93cee9;
    out property <color> accent_bg: is_dark ? #1e5774 : #d7effb;
    out property <color> accent_text: is_dark ? #3daee9 : #0284c7;

    // Tree / Selection
    out property <color> item_hover: is_dark ? #3e4750 : #f1f5f9;
    out property <color> item_active_bg: is_dark ? #1e5774 : #d7effb;
    out property <color> item_active_text: is_dark ? #fcfcfc : #0284c7;
    out property <color> item_active_border: is_dark ? #3daee9 : #7dd3fc;

    // Buttons
    out property <color> btn_bg: is_dark ? #2a2e32 : #e2e8f0;
    out property <color> btn_hover: is_dark ? #3e4750 : #cbd5e1;
    out property <color> btn_active_bg: is_dark ? #3daee9 : #ffffff;
    out property <color> btn_active_text: is_dark ? #ffffff : #0284c7;
    out property <color> btn_active_border: is_dark ? #3daee9 : #cbd5e1;
    out property <color> btn_border: is_dark ? #444b52 : #cbd5e1;

    // Badges
    out property <color> badge_bg: is_dark ? #2a2e32 : #e2e8f0;
    out property <color> badge_text: is_dark ? #a1a9b1 : #475569;

    // Status colors (KDE Breeze: Warning #f67400, Error #da4453, Success #27ae60)
    out property <color> warning_text: #f67400;
    out property <color> warning_bg: is_dark ? #4a3410 : #fef3c7;
    out property <color> warning_border: is_dark ? #875308 : #fcd34d;
    out property <color> error: #da4453;
    out property <color> success: #27ae60;

    // Markdown elements
    out property <color> heading: is_dark ? #fcfcfc : #0f172a;
    out property <color> paragraph: is_dark ? #eff0f1 : #334155;
    out property <color> blockquote_bg: is_dark ? #2a2e32 : #f8fafc;
    out property <color> blockquote_border: #3daee9;
    out property <color> code_block_bg: is_dark ? #1b1e20 : #1e293b;
    out property <color> code_text: is_dark ? #fcfcfc : #f1f5f9;
    out property <color> code_lang: #3daee9;
    out property <color> table_header_bg: is_dark ? #2a2e32 : #f1f5f9;
    out property <color> table_header_text: is_dark ? #fcfcfc : #0f172a;
    out property <color> table_cell_bg: is_dark ? #232629 : #ffffff;
    out property <color> table_alt_row_bg: is_dark ? #282c30 : #f8fafc;
    out property <color> table_cell_text: is_dark ? #eff0f1 : #334155;
    out property <color> table_border: is_dark ? #3d444b : #e2e8f0;
    out property <color> footnote_bg: is_dark ? #2a2e32 : #f1f5f9;
}

export struct TableCellData {
    text: styled-text,
    width: length,
    mid_width: length,
    min_width: length,
    flex_ratio: float,
    ratio: float,
    align: int,
}

export struct TableRowData {
    cells: [TableCellData],
    is_header: bool,
}

export struct ScrollTarget {
    found: bool,
    y: length,
}

export struct MarkdownBlockData {
    block_type: string,
    level: int,
    content: string,
    styled_content: styled-text,
    extra: string,
    footnote_label: string,
    is_checked: bool,
    rows: [TableRowData],
    table_natural_width: length,
    table_mid_width: length,
    table_min_width: length,
    has_links: bool,
}

export struct FileTreeItemData {
    name: string,
    path: string,
    is_dir: bool,
    is_expanded: bool,
    depth: int,
    is_active: bool,
}

component Splitter inherits Rectangle {
    in-out property <bool> is_active: touch.has-hover || touch.pressed;
    callback moved(length);

    width: 6px;
    background: transparent;

    Rectangle {
        width: 1px;
        x: 2px;
        height: 100%;
        background: root.is_active ? Theme.accent : Theme.divider;
        animate background { duration: 150ms; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ew-resize;

        moved => {
            if self.pressed {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
    }
}

component MarkdownEditor inherits Rectangle {
    in-out property <string> text <=> text_input.text;
    in property <string> font_family: "";
    in property <length> font_size: 14px;
    in property <TextWrap> wrap: TextWrap.word-wrap;
    in property <color> text_color: Theme.text_primary;
    in property <color> selection_background_color: Theme.accent;
    in property <color> selection_foreground_color: #ffffff;
    in property <string> placeholder_text: @tr("Enter Markdown text...");
    out property <bool> has_focus: text_input.has-focus;
    out property <int> cursor_position: text_input.cursor-position-byte-offset;
    out property <int> anchor_position: text_input.anchor-position-byte-offset;

    callback formatting_requested(string);
    callback edited(string);
    callback cursor_moved();
    callback tab_pressed();
    callback backtab_pressed();
    callback next_pane_requested();
    callback undo_requested();
    callback redo_requested();
    callback shortcut_requested(string, bool, bool, bool, bool) -> bool;

    public function raw_undo() { text_input.undo(); }
    public function raw_redo() { text_input.redo(); }
    public function undo() { root.undo_requested(); }
    public function redo() { root.redo_requested(); }
    public function cut() { text_input.cut(); }
    public function copy() { text_input.copy(); }
    public function paste() { text_input.paste(); }
    public function select_all() { text_input.select-all(); }
    public function clear_selection() { text_input.clear-selection(); }
    public function focus_input() { text_input.focus(); }
    public function set_selection(anchor: int, focus: int) {
        text_input.set-selection-offsets(anchor, focus);
    }

    forward-focus: text_input;

    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Undo");
                activated => { root.undo_requested(); }
            }
            MenuItem {
                title: @tr("Redo");
                activated => { root.redo_requested(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Cut");
                activated => { text_input.cut(); }
            }
            MenuItem {
                title: @tr("Copy");
                activated => { text_input.copy(); }
            }
            MenuItem {
                title: @tr("Paste");
                activated => { text_input.paste(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Select All");
                activated => { text_input.select-all(); }
            }
        }

        scroll_view := ScrollView {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            height: parent.height - 16px;
            content-width: root.wrap == TextWrap.no-wrap ? max(self.visible-width, text_input.preferred-width) : self.visible-width;
            content-height: max(self.visible-height, text_input.preferred-height);

            text_input := TextInput {
                width: root.wrap == TextWrap.no-wrap ? max(scroll_view.visible-width, self.preferred-width) : scroll_view.visible-width;
                height: max(scroll_view.visible-height, self.preferred-height);
                enabled: true;
                single-line: false;
                font-family: root.font_family;
                font-size: root.font_size;
                color: root.text_color;
                selection-background-color: root.selection_background_color;
                selection-foreground-color: root.selection_foreground_color;
                wrap: root.wrap;
                changed has-focus => {
                    if self.has-focus {
                        self.clear-selection();
                    }
                }

                edited => {
                    root.edited(self.text);
                }

                key-pressed(event) => {
                    if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                        if event.text == Key.Tab || event.text == "\u{0009}" {
                            if !event.modifiers.shift {
                                root.tab_pressed();
                                return accept;
                            } else {
                                root.backtab_pressed();
                                return accept;
                            }
                        }
                        if event.text == Key.Backtab {
                            root.backtab_pressed();
                            return accept;
                        }
                    }
                    if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                        if event.text == Key.Tab || event.text == "\u{0009}" {
                            if !event.modifiers.shift {
                                root.next_pane_requested();
                                return accept;
                            } else {
                                root.backtab_pressed();
                                return accept;
                            }
                        }
                    }
                    if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta {
                        return reject;
                    }
                    if event.modifiers.control || event.modifiers.alt || event.modifiers.meta || event.text == Key.Escape || event.text == Key.Return || event.text == Key.F1 || event.text == Key.F5 || event.text == Key.F6 {
                        if root.shortcut_requested(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                            return accept;
                        }
                    }
                    reject
                }

                cursor-position-changed(cpos) => {
                    root.cursor_moved();
                    if (cpos.x + scroll_view.content-x < 0px) {
                        scroll_view.content-x = min(0px, max(scroll_view.visible-width - self.width, -cpos.x));
                    } else if (cpos.x + scroll_view.content-x > scroll_view.visible-width) {
                        scroll_view.content-x = min(0px, max(scroll_view.visible-width - self.width, scroll_view.visible-width - cpos.x));
                    }

                    if (cpos.y + scroll_view.content-y < 0px) {
                        scroll_view.content-y = min(
                            0px,
                            scroll_view.visible-height - cpos.y - 20px,
                            max(scroll_view.visible-height - self.height, -cpos.y),
                        );
                    } else if (cpos.y + scroll_view.content-y > scroll_view.visible-height - 20px) {
                        scroll_view.content-y = min(0px, max(scroll_view.visible-height - self.height, scroll_view.visible-height - cpos.y - 20px));
                    }
                }
            }
        }
    }

    if root.text == "" && !text_input.has-focus : Text {
        x: 10px;
        y: 8px;
        text: root.placeholder_text;
        font-family: root.font_family;
        font-size: root.font_size;
        color: Theme.text_muted;
    }
}

export component AppWindow inherits Window {
    title: (root.is_modified ? "● " : "") + (root.current_file_name != "" ? root.current_file_name + " — " : "") + "Markdown Editor";
    preferred-width: 1160px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.window_bg;

    // Theme properties (0 = system, 1 = light, 2 = dark)
    in-out property <int> theme_mode: 0;
    in-out property <bool> theme_system_checked: theme_mode == 0;
    in-out property <bool> theme_light_checked: theme_mode == 1;
    in-out property <bool> theme_dark_checked: theme_mode == 2;
    in-out property <bool> is_dark: false;

    // Language properties (0 = auto, 1 = en, 2 = ru)
    in-out property <int> language_mode: 0;
    in-out property <bool> lang_system_checked: language_mode == 0;
    in-out property <bool> lang_en_checked: language_mode == 1;
    in-out property <bool> lang_ru_checked: language_mode == 2;

    // Editor font properties (0 = monospace/system, 1 = Hack, 2 = Ubuntu, 3 = Ubuntu Mono, 4 = Ubuntu Sans)
    in-out property <int> editor_font_mode: 1;
    in-out property <bool> font_system_checked: editor_font_mode == 0;
    in-out property <bool> font_hack_checked: editor_font_mode == 1;
    in-out property <bool> font_ubuntu_checked: editor_font_mode == 2;
    in-out property <bool> font_ubuntu_mono_checked: editor_font_mode == 3;
    in-out property <bool> font_ubuntu_sans_checked: editor_font_mode == 4;
    out property <string> editor_font_family:
        editor_font_mode == 1 ? "Hack Nerd Font" :
        (editor_font_mode == 2 ? "Ubuntu Nerd Font" :
        (editor_font_mode == 3 ? "UbuntuMono Nerd Font" :
        (editor_font_mode == 4 ? "UbuntuSans Nerd Font" : "monospace")));

    // View mode properties (0 = split, 1 = edit only, 2 = preview only)
    in-out property <int> view_mode: 0;
    in-out property <bool> view_split_checked: view_mode == 0;
    in-out property <bool> view_editor_checked: view_mode == 1;
    in-out property <bool> view_preview_checked: view_mode == 2;

    forward-focus: editor;

    init => {
        Palette.color-scheme = root.is_dark ? ColorScheme.dark : ColorScheme.light;
        Theme.is_dark = root.is_dark;
        editor.focus_input();
        editor.clear_selection();
    }

    changed is_dark => {
        Palette.color-scheme = root.is_dark ? ColorScheme.dark : ColorScheme.light;
        Theme.is_dark = root.is_dark;
    }

    // Public functions
    public function raw_undo() { editor.raw_undo(); }
    public function raw_redo() { editor.raw_redo(); }
    public function undo() { root.undo_requested(); }
    public function redo() { root.redo_requested(); }
    public function cut() { editor.cut(); }
    public function copy() {
        if root.active_code_block_index >= 0 && root.active_code_block_has_selection {
            root.copy_active_code_block_selection();
        } else if root.active_preview_block_index >= 0 {
            root.copy_active_preview_block();
        } else if root.active_code_block_index >= 0 {
            root.copy_active_code_block_selection();
        } else {
            editor.copy();
        }
    }
    public function copy_active_code_block_selection() {
        if root.active_code_block_index >= 0 && root.active_code_block_index < root.preview_blocks.length {
            root.copy_code_block_selection(
                root.preview_blocks[root.active_code_block_index].content,
                root.active_code_block_anchor,
                root.active_code_block_cursor,
                root.active_code_block_index
            );
        }
    }
    public function copy_active_preview_block() {
        if root.active_preview_block_index >= 0 && root.active_preview_block_index < root.preview_blocks.length {
            root.copy_preview_block(
                root.preview_blocks[root.active_preview_block_index].content,
                root.active_preview_block_index
            );
        }
    }
    public function paste() { editor.paste(); }
    public function select_all() { editor.select_all(); }
    public function focus_editor() {
        if root.view_mode != 2 {
            editor.focus_input();
            editor.clear_selection();
        }
    }
    public function focus_preview() {
        if root.view_mode != 1 {
            preview_focus.focus();
        }
    }
    public function focus_file_tree() {
        if root.show_files_sidebar {
            file_tree_scope.focus();
        }
    }
    public function focus_next_pane() {
        if root.file_tree_has_focus {
            if root.view_mode != 2 {
                root.focus_editor();
            } else {
                root.focus_preview();
            }
        } else if root.editor_has_focus {
            if root.view_mode != 1 {
                root.focus_preview();
            } else if root.show_files_sidebar {
                root.focus_file_tree();
            }
        } else {
            if root.show_files_sidebar {
                root.focus_file_tree();
            } else if root.view_mode != 2 {
                root.focus_editor();
            }
        }
    }
    public function focus_prev_pane() {
        if root.preview_has_focus {
            if root.view_mode != 2 {
                root.focus_editor();
            } else if root.show_files_sidebar {
                root.focus_file_tree();
            }
        } else if root.editor_has_focus {
            if root.show_files_sidebar {
                root.focus_file_tree();
            } else if root.view_mode != 1 {
                root.focus_preview();
            }
        } else {
            if root.view_mode != 1 {
                root.focus_preview();
            } else if root.view_mode != 2 {
                root.focus_editor();
            }
        }
    }
    public function handle_f6(shift: bool) {
        if shift {
            root.focus_prev_pane();
        } else {
            root.focus_next_pane();
        }
    }
    public function set_editor_selection(anchor: int, focus: int) {
        editor.set_selection(anchor, focus);
    }

    public function set_theme_mode(mode: int) {
        theme_mode = mode;
        theme_system_checked = (mode == 0);
        theme_light_checked = (mode == 1);
        theme_dark_checked = (mode == 2);
    }

    public function set_language_mode(mode: int) {
        language_mode = mode;
        lang_system_checked = (mode == 0);
        lang_en_checked = (mode == 1);
        lang_ru_checked = (mode == 2);
    }

    public function set_editor_font_mode(mode: int) {
        editor_font_mode = mode;
        font_system_checked = (mode == 0);
        font_hack_checked = (mode == 1);
        font_ubuntu_checked = (mode == 2);
        font_ubuntu_mono_checked = (mode == 3);
        font_ubuntu_sans_checked = (mode == 4);
    }

    public function set_view_mode(mode: int) {
        view_mode = mode;
        view_split_checked = (mode == 0);
        view_editor_checked = (mode == 1);
        view_preview_checked = (mode == 2);
        if mode == 1 {
            active_code_block_index = -1;
            active_preview_block_index = -1;
        }
    }

    // Window-level shortcuts via unified Command Registry
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.F6 {
                root.handle_f6(event.modifiers.shift);
                return accept;
            }
            if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta {
                return reject;
            }
            if root.shortcut_requested(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            reject
        }
    }

    // Reactive properties
    in-out property <string> markdown_text: "";
    in property <[MarkdownBlockData]> preview_blocks: [];
    in property <int> word_count: 0;
    in property <int> char_count: 0;
    in property <int> line_count: 0;
    out property <int> editor_cursor_pos: editor.cursor_position;
    out property <int> editor_anchor_pos: editor.anchor_position;
    out property <bool> editor_has_selection: editor.cursor_position != editor.anchor_position;
    out property <bool> editor_has_focus: editor.has_focus;
    out property <bool> preview_has_focus: preview_focus.has-focus;
    out property <bool> file_tree_has_focus: file_tree_scope.has-focus;
    in-out property <int> selected_tree_index: 0;
    in-out property <int> unsaved_dialog_focus_index: 2;
    in-out property <int> table_dialog_focus_index: 1;

    // Active code block selection tracking in preview
    in-out property <int> active_code_block_index: -1;
    in-out property <int> active_code_block_anchor: 0;
    in-out property <int> active_code_block_cursor: 0;
    out property <bool> active_code_block_has_selection:
        root.active_code_block_index >= 0 && root.active_code_block_anchor != root.active_code_block_cursor;

    // Active preview block tracking (headings, quotes, tables, tasks, footnotes, paragraphs, code)
    in-out property <int> active_preview_block_index: -1;
    in-out property <int> copied_preview_block_index: -1;

    out property <string> active_block_copy_menu_title:
        (root.active_preview_block_index >= 0 && root.active_preview_block_index < root.preview_blocks.length) ?
            (root.preview_blocks[root.active_preview_block_index].block_type == "heading" ? @tr("Copy Heading") :
             root.preview_blocks[root.active_preview_block_index].block_type == "quote" ? @tr("Copy Quote") :
             root.preview_blocks[root.active_preview_block_index].block_type == "footnote" ? @tr("Copy Footnote") :
             root.preview_blocks[root.active_preview_block_index].block_type == "table" ? @tr("Copy Table") :
             root.preview_blocks[root.active_preview_block_index].block_type == "task" ? @tr("Copy Task") :
             root.preview_blocks[root.active_preview_block_index].block_type == "code" ? @tr("Copy Code Block") :
             @tr("Copy Paragraph")) : @tr("Copy Block");

    changed editor_has_focus => {
        if root.editor_has_focus {
            root.active_code_block_index = -1;
            root.active_preview_block_index = -1;
            editor.clear_selection();
        }
    }

    // Layout and panel sizing
    in-out property <length> sidebar_width: 240px;
    in-out property <length> editor_width: 450px;

    // File Tree properties
    in-out property <bool> show_files_sidebar: true;
    in property <string> current_directory_name: "";
    in property <string> current_directory_path: "";
    in property <string> current_file_name: "";
    in property <string> current_file_path: "";
    in property <bool> is_modified: false;
    in property <[FileTreeItemData]> file_tree: [];
    in property <int> file_count: 0;

    // Unsaved changes dialog
    in-out property <bool> show_unsaved_dialog: false;

    // Table insertion dialog
    in-out property <bool> show_table_dialog: false;
    in-out property <int> table_dialog_cols: 2;
    in-out property <int> table_dialog_rows: 2;

    // Settings
    in-out property <bool> word_wrap: true;
    in-out property <bool> show_status_bar: true;
    in property <length> estimated_preview_height: 0px;
    in property <length> estimated_preview_height_no_wrap: 0px;
    in-out property <int> preview_version: 0;

    // Footnote navigation
    in-out property <length> footnote_return_y: 0px;

    // Preview copy feedback (0 = none, 1 = HTML copied, 2 = Text copied)
    in-out property <int> copied_code_block_index: -1;
    in-out property <int> preview_copy_feedback: 0;

    // Callbacks
    callback text_edited(string);
    callback copy_code_block(string, int);
    callback copy_code_block_selection(string, int, int, int);
    callback copy_preview_block(string, int);
    callback copy_preview_html_clicked();
    callback copy_preview_text_clicked();
    callback copy_markdown_clicked();
    callback new_file_clicked();
    callback load_sample_clicked();
    callback clear_clicked();
    callback theme_changed(int);
    callback language_changed(int);
    callback file_selected(string);
    callback folder_toggled(string);
    callback refresh_files_clicked();
    callback open_file_clicked();
    callback save_file_clicked();
    callback save_as_clicked();
    callback exit_clicked();
    callback about_clicked();
    callback licenses_clicked();
    callback help_guide_clicked();
    callback insert_formatting(string);
    callback insert_snippet(string);
    callback tab_pressed();
    callback backtab_pressed();
    callback undo_requested();
    callback redo_requested();
    callback unsaved_dialog_save();
    callback unsaved_dialog_discard();
    callback unsaved_dialog_cancel();
    callback insert_custom_table(int, int);
    callback open_external_url(string);
    callback save_footnote_pos(string, length);
    callback get_footnote_pos(string) -> ScrollTarget;
    pure callback compute_preview_height(length, int) -> length;
    callback shortcut_requested(string, bool, bool, bool, bool) -> bool;

    public function handle_preview_link(url: string) {
        if (url == "") {
            return;
        }
        if (url.starts-with("#fn-")) {
            root.footnote_return_y = preview_scroll.content-y;
            root.save_footnote_pos(url, preview_scroll.content-y);
            preview_scroll.content-y = -max(0px, preview_scroll.content-height - preview_scroll.visible-height);
        } else if (url.starts-with("#fnref-")) {
            let target = root.get_footnote_pos(url);
            if (target.found) {
                preview_scroll.content-y = min(0px, target.y);
            } else if (root.footnote_return_y != 0px) {
                preview_scroll.content-y = root.footnote_return_y;
            } else {
                preview_scroll.content-y = 0px;
            }
        } else if (url.starts-with("#")) {
            preview_scroll.content-y = 0px;
        } else {
            root.open_external_url(url);
        }
    }

