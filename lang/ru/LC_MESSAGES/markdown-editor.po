msgstr "Вставить таблицу"

msgid "Specify the number of columns and rows"
msgstr "Укажите количество столбцов и строк"

msgid "Columns:"
msgstr "Столбцы:"

msgid "Rows:"
msgstr "Строки:"

msgid "Quick Grid:"
msgstr "Быстрая сетка:"
